<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="@color/background_light">

    <!-- ================================================= -->
    <!-- HEADER -->
    <!-- ================================================= -->

    <LinearLayout
        android:id="@+id/headerLayout"

        android:layout_width="0dp"
        android:layout_height="wrap_content"

        android:orientation="vertical"

        android:paddingStart="18dp"
        android:paddingTop="22dp"
        android:paddingEnd="18dp"
        android:paddingBottom="8dp"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- TITLE -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:text="Members"

            android:textColor="@color/primary"
            android:textSize="30sp"
            android:textStyle="bold" />

        <!-- MEMBER COUNT -->

        <TextView
            android:id="@+id/txtMemberCount"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="4dp"

            android:text="0 members"

            android:textColor="@color/text_secondary"
            android:textSize="15sp" />

        <!-- ================================================= -->
        <!-- SEARCH + FILTER -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"

            android:layout_marginTop="16dp"

            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- SEARCH -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/searchCard"

                android:layout_width="0dp"
                android:layout_height="match_parent"

                android:layout_weight="1"

                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="29dp"
                app:cardElevation="0dp"
                app:strokeColor="#D9DDDB"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"

                    android:gravity="center_vertical"

                    android:paddingStart="16dp"
                    android:paddingEnd="12dp">

                    <ImageView
                        android:layout_width="25dp"
                        android:layout_height="25dp"

                        android:contentDescription="Search"

                        android:src="@drawable/ic_search"

                        app:tint="@color/text_secondary" />

                    <androidx.appcompat.widget.SearchView
                        android:id="@+id/searchViewMembers"

                        android:layout_width="0dp"
                        android:layout_height="match_parent"

                        android:layout_weight="1"

                        android:background="@android:color/transparent"

                        android:iconifiedByDefault="false"

                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"

                        android:queryHint="Search member..." />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- ================================================= -->
            <!-- FILTER BUTTON -->
            <!-- ================================================= -->

            <com.google.android.material.card.MaterialCardView

                android:layout_width="58dp"
                android:layout_height="58dp"

                android:layout_marginStart="12dp"

                app:cardBackgroundColor="#F0F8F4"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="#D7EAE1"
                app:strokeWidth="1dp">

                <ImageButton
                    android:id="@+id/btnFilterMembers"

                    android:layout_width="match_parent"
                    android:layout_height="match_parent"

                    android:background="?attr/selectableItemBackgroundBorderless"

                    android:contentDescription="Filter members"

                    android:padding="15dp"

                    android:src="@drawable/ic_filter_list"

                    app:tint="@color/primary" />

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </LinearLayout>


    <!-- ================================================= -->
    <!-- CATEGORY TABS -->
    <!-- ================================================= -->

    <LinearLayout
        android:id="@+id/memberCategoryTabs"

        android:layout_width="0dp"
        android:layout_height="66dp"

        android:layout_marginStart="18dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="18dp"

        android:background="@android:color/white"

        android:orientation="horizontal"

        app:layout_constraintTop_toBottomOf="@id/headerLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <!-- ================================================= -->
        <!-- ALL -->
        <!-- ================================================= -->

        <LinearLayout
            android:id="@+id/tabAllMembers"

            android:layout_width="0dp"
            android:layout_height="match_parent"

            android:layout_weight="1"

            android:orientation="vertical">

            <TextView
                android:id="@+id/txtAllMembers"

                android:layout_width="match_parent"
                android:layout_height="0dp"

                android:layout_weight="1"

                android:gravity="center"

                android:text="All (0)"

                android:textColor="@color/primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <View
                android:id="@+id/allIndicator"

                android:layout_width="match_parent"
                android:layout_height="4dp"

                android:background="@color/primary" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- MONTHLY -->
        <!-- ================================================= -->

        <LinearLayout
            android:id="@+id/tabMonthlyMembers"

            android:layout_width="0dp"
            android:layout_height="match_parent"

            android:layout_weight="1"

            android:orientation="vertical">

            <TextView
                android:id="@+id/txtMonthlyMembers"

                android:layout_width="match_parent"
                android:layout_height="0dp"

                android:layout_weight="1"

                android:gravity="center"

                android:text="Monthly Members (0)"

                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <View
                android:id="@+id/monthlyIndicator"

                android:layout_width="match_parent"
                android:layout_height="4dp"

                android:background="@color/primary"

                android:visibility="invisible" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- DAILY -->
        <!-- ================================================= -->

        <LinearLayout
            android:id="@+id/tabDailyMembers"

            android:layout_width="0dp"
            android:layout_height="match_parent"

            android:layout_weight="1"

            android:orientation="vertical">

            <TextView
                android:id="@+id/txtDailyMembers"

                android:layout_width="match_parent"
                android:layout_height="0dp"

                android:layout_weight="1"

                android:gravity="center"

                android:text="Daily Members (0)"

                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <View
                android:id="@+id/dailyIndicator"

                android:layout_width="match_parent"
                android:layout_height="4dp"

                android:background="@color/tiffin_orange"

                android:visibility="invisible" />

        </LinearLayout>

    </LinearLayout>


    <!-- ================================================= -->
    <!-- INFO CARD -->
    <!-- ================================================= -->

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/memberInfoCard"

        android:layout_width="0dp"
        android:layout_height="58dp"

        android:layout_marginStart="18dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="18dp"

        app:cardBackgroundColor="#F5FAF7"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeColor="#DCEBE3"
        app:strokeWidth="1dp"

        app:layout_constraintTop_toBottomOf="@id/memberCategoryTabs"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"

            android:gravity="center_vertical"

            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:layout_width="30dp"
                android:layout_height="30dp"

                android:gravity="center"

                android:text="ⓘ"

                android:textColor="@color/primary"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginStart="10dp"

                android:text="Members are grouped by payment type."

                android:textColor="@color/text_primary"
                android:textSize="13sp" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>


    <!-- ================================================= -->
    <!-- MEMBERS RECYCLER VIEW -->
    <!-- ================================================= -->

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerMembers"

        android:layout_width="0dp"
        android:layout_height="0dp"

        android:clipToPadding="false"

        android:overScrollMode="never"

        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="120dp"

        app:layout_constraintTop_toBottomOf="@id/memberInfoCard"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- ================================================= -->
    <!-- EMPTY STATE -->
    <!-- ================================================= -->

    <LinearLayout
        android:id="@+id/emptyLayout"

        android:layout_width="0dp"
        android:layout_height="wrap_content"

        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"

        android:gravity="center"

        android:orientation="vertical"

        android:padding="24dp"

        android:visibility="gone"

        app:layout_constraintTop_toTopOf="@id/recyclerMembers"
        app:layout_constraintBottom_toBottomOf="@id/recyclerMembers"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.card.MaterialCardView

            android:layout_width="80dp"
            android:layout_height="80dp"

            app:cardBackgroundColor="#E8F6EA"
            app:cardCornerRadius="40dp"
            app:cardElevation="0dp">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"

                android:layout_gravity="center"

                android:contentDescription="No members"

                android:src="@drawable/ic_group_members"

                app:tint="@color/primary" />

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="16dp"

            android:text="No members yet"

            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="6dp"

            android:gravity="center"

            android:text="Add your first member to start managing your mess."

            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

    </LinearLayout>


    <!-- ================================================= -->
    <!-- ADD MEMBER FAB -->
    <!-- ================================================= -->

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddMember"

        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:layout_marginEnd="22dp"
        android:layout_marginBottom="24dp"

        android:contentDescription="Add Member"

        android:src="@drawable/ic_add"

        app:backgroundTint="@color/primary"

        app:elevation="7dp"

        app:maxImageSize="30dp"

        app:tint="@android:color/white"

        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>