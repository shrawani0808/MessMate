<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="@color/background_light"

    android:fillViewport="true"

    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:orientation="vertical"

        android:paddingStart="18dp"
        android:paddingTop="18dp"
        android:paddingEnd="18dp"
        android:paddingBottom="100dp">

        <!-- ================================================= -->
        <!-- HEADER -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:text="Today's Collection"

            android:textColor="@color/primary"
            android:textSize="28sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="8dp"

            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="28dp"
                android:layout_height="28dp"

                android:gravity="center"

                android:text="▣"
                android:textColor="@color/primary"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/txtTodayDate"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginStart="8dp"

                android:text="Thursday, 13 August 2026"

                android:textColor="@color/text_primary"
                android:textSize="15sp" />

        </LinearLayout>

        <!-- ================================================= -->
        <!-- SUMMARY CARD -->
        <!-- ================================================= -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="22dp"

            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="22dp"
            app:cardElevation="1dp"
            app:strokeColor="#E7ECE9"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:orientation="horizontal"

                android:padding="12dp">

                <!-- LUNCH -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"

                    android:layout_weight="1"

                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="58dp"
                        android:layout_height="58dp"

                        android:background="#E8F5EE"

                        android:gravity="center"

                        android:text="🍴"
                        android:textSize="26sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="7dp"

                        android:text="Lunch Collected"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtLunchCollectedCount"

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="4dp"

                        android:text="0"
                        android:textColor="@color/primary"
                        android:textSize="25sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="5dp"

                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/txtLunchFullCount"

                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"

                            android:text="Full: 0"
                            android:textColor="@color/primary"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtLunchHalfCount"

                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"

                            android:layout_marginStart="8dp"

                            android:text="Half: 0"
                            android:textColor="#F57C00"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtLunchNotCount"

                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"

                            android:layout_marginStart="8dp"

                            android:text="Not: 0"
                            android:textColor="#E53935"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="135dp"

                    android:layout_gravity="center_vertical"

                    android:background="#E8ECEA" />

                <!-- DINNER -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"

                    android:layout_weight="1"

                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="58dp"
                        android:layout_height="58dp"

                        android:background="#FFF0E1"

                        android:gravity="center"

                        android:text="🍽"
                        android:textSize="26sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="7dp"

                        android:text="Dinner Collected"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtDinnerCollectedCount"

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="4dp"

                        android:text="0"
                        android:textColor="@color/tiffin_orange"
                        android:textSize="25sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="5dp"

                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/txtDinnerFullCount"

                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"

                            android:text="Full: 0"
                            android:textColor="@color/primary"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtDinnerHalfCount"

                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"

                            android:layout_marginStart="8dp"

                            android:text="Half: 0"
                            android:textColor="#F57C00"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtDinnerNotCount"

                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"

                            android:layout_marginStart="8dp"

                            android:text="Not: 0"
                            android:textColor="#E53935"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="135dp"

                    android:layout_gravity="center_vertical"

                    android:background="#E8ECEA" />

                <!-- NOT COLLECTED -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"

                    android:layout_weight="0.75"

                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="58dp"
                        android:layout_height="58dp"

                        android:background="#FDEAEA"

                        android:gravity="center"

                        android:text="⊗"
                        android:textColor="#E53935"
                        android:textSize="27sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="7dp"

                        android:text="Not Collected"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtNotCollectedCount"

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="4dp"

                        android:text="0"
                        android:textColor="#E53935"
                        android:textSize="25sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtTotalMembers"

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="7dp"

                        android:text="Total Members: 0"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ================================================= -->
        <!-- SEARCH -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"

            android:layout_marginTop="20dp"

            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="match_parent"

                android:layout_weight="1"

                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="17dp"
                app:cardElevation="0dp"
                app:strokeColor="#E1E7E4"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"

                    android:gravity="center_vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">

                    <TextView
                        android:layout_width="32dp"
                        android:layout_height="32dp"

                        android:gravity="center"

                        android:text="⌕"
                        android:textColor="@color/text_secondary"
                        android:textSize="28sp" />

                    <EditText
                        android:id="@+id/etSearchTiffin"

                        android:layout_width="0dp"
                        android:layout_height="match_parent"

                        android:layout_weight="1"

                        android:background="@android:color/transparent"

                        android:hint="Search member..."
                        android:inputType="text"
                        android:maxLines="1"

                        android:paddingStart="8dp"

                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_secondary"
                        android:textSize="15sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="56dp"
                android:layout_height="56dp"

                android:layout_marginStart="10dp"

                app:cardBackgroundColor="#F0F8F4"
                app:cardCornerRadius="17dp"
                app:cardElevation="0dp"
                app:strokeColor="#DDEDE5"
                app:strokeWidth="1dp">

                <ImageButton
                    android:id="@+id/btnFilter"

                    android:layout_width="match_parent"
                    android:layout_height="match_parent"

                    android:background="@android:color/transparent"

                    android:contentDescription="Filter"

                    android:src="@android:drawable/ic_menu_sort_by_size"

                    app:tint="@color/primary" />

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- ================================================= -->
        <!-- MEMBER TYPE TABS -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"

            android:layout_marginTop="18dp"

            android:background="@android:color/white"

            android:orientation="horizontal">

            <!-- MONTHLY -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"

                android:layout_weight="1"

                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtMonthlyMembers"

                    android:layout_width="match_parent"
                    android:layout_height="0dp"

                    android:layout_weight="1"

                    android:gravity="center"

                    android:text="Monthly Members"

                    android:textColor="@color/primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <View
                    android:id="@+id/monthlyIndicator"

                    android:layout_width="match_parent"
                    android:layout_height="4dp"

                    android:background="@color/primary" />

            </LinearLayout>


            <!-- DAILY -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"

                android:layout_weight="1"

                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtDailyMembers"

                    android:layout_width="match_parent"
                    android:layout_height="0dp"

                    android:layout_weight="1"

                    android:gravity="center"

                    android:text="Daily Members"

                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <View
                    android:id="@+id/dailyIndicator"

                    android:layout_width="match_parent"
                    android:layout_height="4dp"

                    android:background="@color/tiffin_orange"

                    android:visibility="invisible" />

            </LinearLayout>

        </LinearLayout>

        <!-- ================================================= -->
        <!-- INFO -->
        <!-- ================================================= -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="66dp"

            android:layout_marginTop="14dp"

            app:cardBackgroundColor="#F5FAF7"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="#E0EEE7"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"

                android:gravity="center_vertical"

                android:paddingStart="18dp"
                android:paddingEnd="18dp">

                <TextView
                    android:layout_width="34dp"
                    android:layout_height="34dp"

                    android:gravity="center"

                    android:text="ⓘ"
                    android:textColor="@color/primary"
                    android:textSize="23sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginStart="12dp"

                    android:text="Status is shown separately for Lunch &amp; Dinner."
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ================================================= -->
        <!-- MONTHLY SECTION -->
        <!-- ================================================= -->

        <LinearLayout
            android:id="@+id/monthlySection"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="20dp"

            android:orientation="vertical">

            <TextView
                android:id="@+id/txtMonthlySectionTitle"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginStart="6dp"

                android:text="Monthly Members (Both)"

                android:textColor="@color/primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerMonthly"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="8dp"

                android:nestedScrollingEnabled="false"

                android:clipToPadding="false" />

        </LinearLayout>

        <!-- ================================================= -->
        <!-- DAILY SECTION -->
        <!-- ================================================= -->

        <LinearLayout
            android:id="@+id/dailySection"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="22dp"

            android:orientation="vertical">

            <TextView
                android:id="@+id/txtDailySectionTitle"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginStart="6dp"

                android:text="Daily Members (Both)"

                android:textColor="@color/tiffin_orange"
                android:textSize="17sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerDaily"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="8dp"

                android:nestedScrollingEnabled="false"

                android:clipToPadding="false" />

        </LinearLayout>

        <!-- ================================================= -->
        <!-- EMPTY -->
        <!-- ================================================= -->

        <LinearLayout
            android:id="@+id/emptyLayout"

            android:layout_width="match_parent"
            android:layout_height="220dp"

            android:gravity="center"

            android:orientation="vertical"

            android:visibility="gone">

            <TextView
                android:layout_width="64dp"
                android:layout_height="64dp"

                android:background="#E8F5EE"

                android:gravity="center"

                android:text="✓"
                android:textColor="@color/primary"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginTop="12dp"

                android:text="No members found"

                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginTop="5dp"

                android:text="No members in this category"

                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>