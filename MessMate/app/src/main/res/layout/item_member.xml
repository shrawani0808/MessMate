<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="wrap_content"

    android:layout_marginStart="6dp"
    android:layout_marginEnd="6dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"

    app:cardBackgroundColor="@android:color/white"
    app:cardCornerRadius="22dp"
    app:cardElevation="1dp"
    app:strokeColor="#E4E9E6"
    app:strokeWidth="1dp">


    <androidx.constraintlayout.widget.ConstraintLayout

        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:minHeight="165dp"

        android:padding="16dp">


        <!-- ================================================= -->
        <!-- MEMBER INITIAL -->
        <!-- ================================================= -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/initialContainer"

            android:layout_width="58dp"
            android:layout_height="58dp"

            app:cardBackgroundColor="#E8F6EA"
            app:cardCornerRadius="29dp"
            app:cardElevation="0dp"
            app:strokeColor="#D5E9DD"
            app:strokeWidth="1dp"

            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/txtInitial"

                android:layout_width="match_parent"
                android:layout_height="match_parent"

                android:gravity="center"

                android:text="M"

                android:textColor="@color/primary"
                android:textSize="23sp"
                android:textStyle="bold" />

        </com.google.android.material.card.MaterialCardView>


        <!-- ================================================= -->
        <!-- DELETE BUTTON -->
        <!-- ================================================= -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/deleteContainer"

            android:layout_width="46dp"
            android:layout_height="46dp"

            app:cardBackgroundColor="#FFF7EE"
            app:cardCornerRadius="15dp"
            app:cardElevation="0dp"
            app:strokeColor="#F0DCC7"
            app:strokeWidth="1dp"

            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageButton
                android:id="@+id/btnDeleteMember"

                android:layout_width="match_parent"
                android:layout_height="match_parent"

                android:background="?attr/selectableItemBackgroundBorderless"

                android:contentDescription="Delete member"

                android:padding="12dp"

                android:src="@drawable/ic_delete_member"

                app:tint="#F28A18" />

        </com.google.android.material.card.MaterialCardView>


        <!-- ================================================= -->
        <!-- MEMBER NAME -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/txtMemberName"

            android:layout_width="0dp"
            android:layout_height="wrap_content"

            android:layout_marginStart="14dp"
            android:layout_marginEnd="10dp"

            android:ellipsize="end"
            android:maxLines="1"

            android:text="Member Name"

            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold"

            app:layout_constraintStart_toEndOf="@id/initialContainer"
            app:layout_constraintTop_toTopOf="@id/initialContainer"
            app:layout_constraintEnd_toStartOf="@id/deleteContainer" />


        <!-- ================================================= -->
        <!-- PHONE -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/txtMemberPhone"

            android:layout_width="0dp"
            android:layout_height="wrap_content"

            android:layout_marginStart="14dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="10dp"

            android:ellipsize="end"
            android:maxLines="1"

            android:text="9876543210"

            android:textColor="@color/text_secondary"
            android:textSize="13sp"

            app:layout_constraintStart_toEndOf="@id/initialContainer"
            app:layout_constraintTop_toBottomOf="@id/txtMemberName"
            app:layout_constraintEnd_toStartOf="@id/deleteContainer" />


        <!-- ================================================= -->
        <!-- EMAIL -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/txtMemberEmail"

            android:layout_width="0dp"
            android:layout_height="wrap_content"

            android:layout_marginStart="14dp"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="10dp"

            android:ellipsize="end"
            android:maxLines="1"

            android:text="member@gmail.com"

            android:textColor="@color/text_secondary"
            android:textSize="13sp"

            app:layout_constraintStart_toEndOf="@id/initialContainer"
            app:layout_constraintTop_toBottomOf="@id/txtMemberPhone"
            app:layout_constraintEnd_toStartOf="@id/deleteContainer" />


        <!-- ================================================= -->
        <!-- MEMBER PLAN -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/txtMemberPlan"

            android:layout_width="0dp"
            android:layout_height="wrap_content"

            android:layout_marginStart="72dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="8dp"

            android:ellipsize="end"
            android:maxLines="1"

            android:text="Daily • Lunch + Dinner"

            android:textColor="@color/primary"
            android:textSize="12sp"
            android:textStyle="bold"

            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/initialContainer"
            app:layout_constraintEnd_toEndOf="parent" />


        <!-- ================================================= -->
        <!-- ACTIVE STATUS -->
        <!-- ================================================= -->

        <LinearLayout
            android:id="@+id/statusBadge"

            android:layout_width="wrap_content"
            android:layout_height="30dp"

            android:layout_marginStart="72dp"
            android:layout_marginTop="7dp"

            android:background="@drawable/bg_active_badge"

            android:gravity="center_vertical"

            android:orientation="horizontal"

            android:paddingStart="10dp"
            android:paddingEnd="12dp"

            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/txtMemberPlan">

            <View
                android:layout_width="8dp"
                android:layout_height="8dp"

                android:background="@drawable/bg_status_dot" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginStart="6dp"

                android:text="Active"

                android:textColor="@color/primary"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>