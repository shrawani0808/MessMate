<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootOwnerOrders"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Header Title -->
    <TextView
        android:id="@+id/tvOrdersTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:text="Orders"
        android:textColor="#1A1A1A"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Notification Bell Button -->
    <ImageButton
        android:id="@+id/btnNotification"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="16dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Notification Bell"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:src="@android:drawable/ic_popup_reminder"
        app:layout_constraintBottom_toBottomOf="@id/tvOrdersTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tvOrdersTitle"
        app:tint="#1B8E32" />

    <!-- Horizontal Tab Filters (All, Pending, Completed, Cancelled) -->
    <HorizontalScrollView
        android:id="@+id/scrollTabs"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:scrollbars="none"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvOrdersTitle">

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggleGroupOrders"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            app:checkedButton="@id/btnTabAll"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTabAll"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="All"
                android:textColor="#1B8E32"
                android:textSize="13sp"
                app:strokeColor="#1B8E32" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTabPending"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pending"
                android:textColor="#757575"
                android:textSize="13sp"
                app:strokeColor="#EAEAEA" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTabCompleted"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Completed"
                android:textColor="#757575"
                android:textSize="13sp"
                app:strokeColor="#EAEAEA" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTabCancelled"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cancelled"
                android:textColor="#757575"
                android:textSize="13sp"
                app:strokeColor="#EAEAEA" />

        </com.google.android.material.button.MaterialButtonToggleGroup>
    </HorizontalScrollView>

    <!-- Orders List RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvOrdersList"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:clipToPadding="false"
        android:paddingBottom="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/scrollTabs"
        tools:listitem="@layout/item_owner_order" />

</androidx.constraintlayout.widget.ConstraintLayout>