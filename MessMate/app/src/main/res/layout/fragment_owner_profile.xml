<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="22dp"
        android:paddingEnd="16dp"
        android:paddingBottom="30dp">

        <!-- ===================================================== -->
        <!-- PROFILE HEADER -->
        <!-- ===================================================== -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Profile"
            android:textColor="@color/primary_green"
            android:textSize="27sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Manage your account &amp; preferences"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />


        <!-- ===================================================== -->
        <!-- PROFILE CARD -->
        <!-- ===================================================== -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="24dp"
            app:cardElevation="2dp"
            app:strokeColor="#E6ECE8"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- PROFILE TOP AREA -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- AVATAR + EDIT -->

                    <FrameLayout
                        android:layout_width="92dp"
                        android:layout_height="92dp">

                        <TextView
                            android:id="@+id/txtProfileInitial"
                            android:layout_width="82dp"
                            android:layout_height="82dp"
                            android:layout_gravity="top|start"
                            android:background="@drawable/profile_circle"
                            android:gravity="center"
                            android:text="M"
                            android:textColor="@android:color/white"
                            android:textSize="30sp"
                            android:textStyle="bold" />

                        <!-- Edit icon -->

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/btnEditProfile"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:layout_gravity="bottom|end"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Edit profile"
                            app:cardBackgroundColor="@android:color/white"
                            app:cardCornerRadius="19dp"
                            app:cardElevation="3dp"
                            app:strokeColor="#E6ECE8"
                            app:strokeWidth="1dp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:contentDescription="Edit profile"
                                android:src="@drawable/ic_edit"
                                app:tint="@color/primary_green" />

                        </com.google.android.material.card.MaterialCardView>

                    </FrameLayout>


                    <!-- PROFILE DETAILS -->

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txtProfileName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:text="Mess Owner"
                            android:textColor="@color/text_primary"
                            android:textSize="21sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtProfileEmail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:text="owner@test.com"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp" />

                        <!-- ROLE -->

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipRole"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:layout_marginTop="10dp"
                            android:clickable="false"
                            android:focusable="false"
                            android:text="OWNER"
                            android:textColor="@color/primary_green"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            app:chipBackgroundColor="#EEF8F3"
                            app:chipCornerRadius="17dp"
                            app:chipIcon="@drawable/ic_crown"
                            app:chipIconTint="@color/primary_green"
                            app:chipIconVisible="true"
                            app:closeIconVisible="false"
                            app:strokeColor="#D4E9DE"
                            app:strokeWidth="1dp" />

                        <!-- Required by OwnerProfileFragment.java -->

                        <TextView
                            android:id="@+id/txtAccountRole"
                            android:layout_width="1dp"
                            android:layout_height="1dp"
                            android:visibility="gone"
                            android:text="Owner" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- ===================================================== -->
        <!-- ACCOUNT TITLE -->
        <!-- ===================================================== -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Account"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />


        <!-- ===================================================== -->
        <!-- ACCOUNT CARD -->
        <!-- ===================================================== -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="22dp"
            app:cardElevation="1dp"
            app:strokeColor="#E6ECE8"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">


                <!-- ================================================= -->
                <!-- EMAIL ROW -->
                <!-- ================================================= -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="82dp"
                    android:orientation="horizontal"
                    android:padding="8dp">

                    <!-- EMAIL ICON -->

                    <LinearLayout
                        android:layout_width="54dp"
                        android:layout_height="54dp"
                        android:background="@drawable/profile_info_icon_background"
                        android:gravity="center">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="Email"
                            android:src="@drawable/ic_email"
                            app:tint="@color/primary_green" />

                    </LinearLayout>


                    <!-- EMAIL DETAILS -->

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Email Address"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/txtAccountEmail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:text="owner@test.com"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </LinearLayout>


                <!-- DIVIDER -->

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="68dp"
                    android:layout_marginEnd="4dp"
                    android:background="#E8ECEA" />


                <!-- ================================================= -->
                <!-- FORGOT PASSWORD -->
                <!-- ================================================= -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/profile_password_background"
                    android:gravity="center_vertical"
                    android:minHeight="112dp"
                    android:orientation="horizontal"
                    android:padding="14dp">


                    <!-- LOCK ICON -->

                    <LinearLayout
                        android:layout_width="58dp"
                        android:layout_height="58dp"
                        android:background="@drawable/profile_info_icon_background"
                        android:gravity="center">

                        <ImageView
                            android:layout_width="25dp"
                            android:layout_height="25dp"
                            android:contentDescription="Password"
                            android:src="@drawable/ic_lock"
                            app:tint="@color/primary_green" />

                    </LinearLayout>


                    <!-- FORGOT PASSWORD TEXT -->

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Forgot Password?"
                            android:textColor="@color/primary_green"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="Reset your password to regain access"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp" />

                    </LinearLayout>


                    <!-- RESET PASSWORD BUTTON -->

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnResetPassword"
                        android:layout_width="wrap_content"
                        android:layout_height="46dp"
                        android:minWidth="118dp"
                        android:text="Reset Password"
                        android:textAllCaps="false"
                        android:textColor="@color/primary_green"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        app:backgroundTint="@android:color/transparent"
                        app:cornerRadius="23dp"
                        app:strokeColor="@color/primary_green"
                        app:strokeWidth="1dp" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- ===================================================== -->
        <!-- LOGOUT BUTTON -->
        <!-- ===================================================== -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="24dp"
            android:text="Logout"
            android:textAllCaps="false"
            android:textColor="#F28A00"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="#FFF8EF"
            app:cornerRadius="18dp"
            app:icon="@drawable/ic_logout"
            app:iconGravity="textStart"
            app:iconPadding="10dp"
            app:iconTint="#F28A00"
            app:rippleColor="#FFE8C8"
            app:strokeColor="#F5B566"
            app:strokeWidth="1dp" />


    </LinearLayout>

</androidx.core.widget.NestedScrollView>