<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="30dp"
    android:paddingEnd="30dp"
    android:paddingTop="28dp"
    android:paddingBottom="24dp"
    android:background="@drawable/bg_generate_bill_dialog">

    <!-- =============================================== -->
    <!-- HEADER -->
    <!-- =============================================== -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- BILL ICON -->

        <LinearLayout
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:gravity="center"
            android:background="@drawable/bg_bill_icon">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_receipt"
                android:contentDescription="Bill" />

        </LinearLayout>


        <!-- HEADER TEXT -->

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="18dp">

            <TextView
                android:id="@+id/tvBillTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Monthly Bill"
                android:textSize="23sp"
                android:textStyle="bold"
                android:textColor="#222222" />

            <TextView
                android:id="@+id/tvBillMember"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Member: ram"
                android:textSize="16sp"
                android:textColor="#555555" />

        </LinearLayout>

    </LinearLayout>


    <!-- =============================================== -->
    <!-- DIVIDER -->
    <!-- =============================================== -->

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="22dp"
        android:background="#E5E9E7" />


    <!-- =============================================== -->
    <!-- MONTH -->
    <!-- =============================================== -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Month"
            android:textSize="16sp"
            android:textColor="#333333" />

        <TextView
            android:id="@+id/tvBillMonth"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="August 2026"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#2F8464" />

    </LinearLayout>


    <!-- =============================================== -->
    <!-- RATE -->
    <!-- =============================================== -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Tiffin Rate (per tiffin)"
            android:textSize="16sp"
            android:textColor="#333333" />

        <TextView
            android:id="@+id/tvBillRate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="₹ 50.00"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#2F8464" />

    </LinearLayout>


    <!-- =============================================== -->
    <!-- FULL TIFFINS -->
    <!-- =============================================== -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Full Tiffins"
            android:textSize="16sp"
            android:textColor="#333333" />

        <TextView
            android:id="@+id/tvFullTiffins"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#2F8464" />

    </LinearLayout>


    <!-- =============================================== -->
    <!-- HALF TIFFINS -->
    <!-- =============================================== -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Half Tiffins"
            android:textSize="16sp"
            android:textColor="#333333" />

        <TextView
            android:id="@+id/tvHalfTiffins"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#2F8464" />

    </LinearLayout>


    <!-- =============================================== -->
    <!-- TIFFIN QUANTITY -->
    <!-- =============================================== -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Tiffin Quantity"
            android:textSize="16sp"
            android:textColor="#333333" />

        <TextView
            android:id="@+id/tvTiffinQuantity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1.5"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#2F8464" />

    </LinearLayout>


    <!-- =============================================== -->
    <!-- COLLECTED DAYS -->
    <!-- =============================================== -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Collected Days"
            android:textSize="16sp"
            android:textColor="#333333" />

        <TextView
            android:id="@+id/tvCollectedDays"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#2F8464" />

    </LinearLayout>


    <!-- =============================================== -->
    <!-- TOTAL DIVIDER -->
    <!-- =============================================== -->

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="22dp"
        android:background="#E5E9E7" />


    <!-- =============================================== -->
    <!-- TOTAL -->
    <!-- =============================================== -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="TOTAL BILL"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#2F8464" />

        <TextView
            android:id="@+id/tvTotalBill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="₹ 75.00"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#2F8464" />

    </LinearLayout>


    <!-- =============================================== -->
    <!-- BUTTONS -->
    <!-- =============================================== -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCloseBill"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="Close"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#2F8464"
            app:cornerRadius="15dp"
            app:strokeWidth="1dp"
            app:strokeColor="#2F8464"
            android:backgroundTint="#FFFFFF" />


        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGeneratePdf"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginStart="18dp"
            android:text="Generate PDF"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            app:cornerRadius="15dp"
            android:backgroundTint="#2F8464" />

    </LinearLayout>

</LinearLayout>