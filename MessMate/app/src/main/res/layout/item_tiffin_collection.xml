<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="wrap_content"

    android:layout_marginStart="2dp"
    android:layout_marginEnd="2dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"

    app:cardBackgroundColor="@android:color/white"
    app:cardCornerRadius="18dp"
    app:cardElevation="2dp"
    app:strokeColor="#E8ECEA"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"

        android:paddingStart="16dp"
        android:paddingTop="15dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp">


        <!-- ================================================= -->
        <!-- MEMBER HEADER -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:gravity="center_vertical"
            android:orientation="horizontal">


            <!-- MEMBER INITIAL -->

            <TextView
                android:id="@+id/txtInitial"

                android:layout_width="44dp"
                android:layout_height="44dp"

                android:background="@drawable/bg_member_avatar"

                android:gravity="center"

                android:text="R"
                android:textColor="@color/primary"
                android:textSize="19sp"
                android:textStyle="bold" />


            <!-- MEMBER DETAILS -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"

                android:layout_marginStart="12dp"
                android:layout_weight="1"

                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtMemberName"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="Ram"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtMemberPhone"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="3dp"

                    android:text="0987654321"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>


        <!-- ================================================= -->
        <!-- TIFFIN STATUS -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="14dp"

            android:text="Tiffin Status"
            android:textColor="@color/primary"
            android:textSize="14sp"
            android:textStyle="bold" />


        <!-- ================================================= -->
        <!-- TIFFIN OPTIONS -->
        <!-- ================================================= -->

        <RadioGroup
            android:id="@+id/radioTiffin"

            android:layout_width="match_parent"
            android:layout_height="44dp"

            android:layout_marginTop="6dp"

            android:background="@drawable/bg_tiffin_options"

            android:gravity="center_vertical"
            android:orientation="horizontal">


            <RadioButton
                android:id="@+id/radioFull"

                android:layout_width="0dp"
                android:layout_height="match_parent"

                android:layout_weight="1"

                android:buttonTint="@color/primary"

                android:gravity="center_vertical"

                android:paddingStart="4dp"

                android:text="Full"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />


            <RadioButton
                android:id="@+id/radioHalf"

                android:layout_width="0dp"
                android:layout_height="match_parent"

                android:layout_weight="1"

                android:buttonTint="#FF7043"

                android:gravity="center_vertical"

                android:paddingStart="4dp"

                android:text="Half"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />


            <RadioButton
                android:id="@+id/radioNone"

                android:layout_width="0dp"
                android:layout_height="match_parent"

                android:layout_weight="1"

                android:buttonTint="@color/red"

                android:gravity="center_vertical"

                android:paddingStart="4dp"

                android:text="Not Collected"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

        </RadioGroup>


        <!-- ================================================= -->
        <!-- DINNER + SWITCH + SUBMIT -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="10dp"

            android:gravity="center_vertical"
            android:orientation="horizontal">


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="Dinner"
                android:textColor="@color/primary"
                android:textSize="14sp"
                android:textStyle="bold" />


            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchDinner"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginStart="3dp"

                android:scaleX="0.80"
                android:scaleY="0.80"

                android:text="" />


            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />


            <!-- SUBMIT BUTTON -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSubmit"

                android:layout_width="108dp"
                android:layout_height="40dp"

                android:text="Submit"
                android:textAllCaps="false"
                android:textColor="@color/primary"
                android:textSize="13sp"
                android:textStyle="bold"

                app:backgroundTint="@android:color/transparent"
                app:cornerRadius="12dp"
                app:strokeColor="@color/primary"
                app:strokeWidth="1dp" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>